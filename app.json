{
  "expo": {
    "name": "sayNote",
    "slug": "sayNote",
    "scheme": "sayNote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sayNote.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "sayNote needs access to your microphone to record voice notes and commands.",
        "NSPhotoLibraryUsageDescription": "sayNote needs access to your photo library to allow you to add images to your notes.",
        "NSCameraUsageDescription": "sayNote needs access to your camera to allow you to take photos for your notes.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.sayNote.app",
      "versionCode": 1,
      "navigationBar": {
        "visible": true,
        "barStyle": "dark-content",
        "backgroundColor": "#F3F8FF"
      },
      "permissions": [
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "sayNote"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-navigation-bar",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "sayNote needs to access your Face ID to secure your notes."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "sayNote needs access to your microphone to record voice notes and commands."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "expo-navigation-bar": {},
      "eas": {
        "projectId": "4bee69d0-ddb3-4c0e-bea2-27c56ab22c27"
      }
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "owner": "ayoubsddd",
    "updates": {
      "fallbackToCacheTimeout": 0,
      "enabled": false
    }
  }
}
